# ---- Tadka backend config ----
PORT=8787

# CORS — comma-separated origins allowed to call this API.
# Vite dev server + Capacitor WebView origins.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,https://localhost,capacitor://localhost

# ---- Swiggy Instamart MCP ----
# Leave disabled until you have Swiggy Builders credentials + an approved demo video.
# When false, every MCP tool call is served from server/src/mcp/mock.js.
SWIGGY_MCP_ENABLED=false
SWIGGY_MCP_URL=https://mcp.swiggy.com/im

# OAuth 2.1 + PKCE (delegated, per-user). Fill these once you have a Builders app.
SWIGGY_OAUTH_CLIENT_ID=
SWIGGY_OAUTH_AUTHORIZE_URL=
SWIGGY_OAUTH_TOKEN_URL=
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:8787/auth/swiggy/callback

# ---- Video -> ingredients pipeline ----
# VIDEO_RESOLVE_ENABLED: pull real title / thumbnail / embed / transcript.
#   YouTube needs the `yt-dlp` binary on PATH (brew install yt-dlp / pipx install yt-dlp).
#   Other URLs are fetched directly (no binary).
# LLM_ENABLED: run Claude to extract the ingredient list from the resolved text.
#   With VIDEO_RESOLVE_ENABLED=true and LLM_ENABLED=false you get the real player
#   with the fixture ingredient list (handy for demos without an API key).
VIDEO_RESOLVE_ENABLED=false
YTDLP_PATH=yt-dlp
YOUTUBE_NOCOOKIE=true

LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
